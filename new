<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control Remoto - Rotor de Antena</title>
    <!-- Librería MQTT sobre WebSockets -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js" type="text/javascript"></script>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; background: #121212; color: #fff; margin-top: 20px; }
        .btn { padding: 12px 20px; font-size: 16px; margin: 8px; cursor: pointer; border: none; border-radius: 5px; font-weight: bold; }
        .btn-power { background: #ff9800; color: white; } 
        .btn-cw { background: #2196F3; color: white; } 
        .btn-ccw { background: #9c27b0; color: white; } 
        .btn-stop { background: #f44336; color: white; }
        input { padding: 10px; font-size: 16px; width: 100px; text-align: center; border-radius: 4px; border: none; }
        .compass { width: 200px; height: 200px; border: 5px solid #fff; border-radius: 50%; margin: 20px auto; position: relative; display: flex; align-items: center; justify-content: center; }
        .needle { width: 4px; height: 90px; background: red; position: absolute; top: 10px; transform-origin: bottom center; transition: transform 0.3s; }
        #conexion { font-size: 14px; margin-bottom: 15px; color: #f44336; }
    </style>
</head>
<body>

    <h1>Control Remoto - Rotor de Antena</h1>
    <div id="conexion">Estado: Desconectado del Broker MQTT</div>
    <p>Posición Actual: <span id='pos'>0</span>° | Estado Power: <span id='pwr'>OFF</span></p>
    
    <!-- Brújula visual -->
    <div class='compass'>
        <div id='needle' class='needle'></div>
        <span style='position:absolute;top:5px;'>N</span>
        <span style='position:absolute;bottom:5px;'>S</span>
        <span style='position:absolute;left:5px;'>W</span>
        <span style='position:absolute;right:5px;'>E</span>
    </div>

    <!-- Controles de Mando -->
    <button class='btn btn-power' onclick="enviarComando('POWER_ON')">Encender Power (1 min)</button><br>
    <button class='btn btn-cw' onmousedown="enviarComando('CW_ON')" onmouseup="enviarComando('STOP')" ontouchstart="enviarComando('CW_ON')" ontouchend="enviarComando('STOP')">Giro Horario</button>
    <button class='btn btn-ccw' onmousedown="enviarComando('CCW_ON')" onmouseup="enviarComando('STOP')" ontouchstart="enviarComando('CCW_ON')" ontouchend="enviarComando('STOP')">Giro Antihorario</button>
    <button class='btn btn-stop' onclick="enviarComando('STOP')">STOP General</button><br><br>

    <!-- Posicionamiento Automático -->
    <div>
        <input type='number' id='targetInput' placeholder='Grados' min='0' max='360'>
        <button class='btn btn-cw' onclick='enviarTarget()'>Ir a Dirección</button>
    </div>

    <script>
        // Configuración de Conexión MQTT WebSockets (HiveMQ ofrece puerto WS en 8000)
        const brokerHost = "broker.hivemq.com";
        const brokerPort = 8000; 
        const clientId = "WebClient_Rotor_" + parseInt(Math.random() * 100000);

        client = new Paho.MQTT.Client(brokerHost, Number(brokerPort), clientId);

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        client.connect({ onSuccess: onConnect });

        function onConnect() {
            document.getElementById("conexion").innerText = "Estado: Conectado OK";
            document.getElementById("conexion").style.color = "#4CAF50";
            client.subscribe("rotor/estado");
        }

        function onConnectionLost(responseObject) {
            if (responseObject.errorCode !== 0) {
                document.getElementById("conexion").innerText = "Estado: Conexión perdida - Reconectando...";
                document.getElementById("conexion").style.color = "#f44336";
                setTimeout(() => client.connect({ onSuccess: onConnect }), 5000);
            }
        }

        function onMessageArrived(message) {
            if (message.destinationName === "rotor/estado") {
                let data = JSON.parse(message.payloadString);
                document.getElementById('pos').innerText = data.pos.toFixed(1);
                document.getElementById('pwr').innerText = data.power ? 'ON' : 'OFF';
                document.getElementById('needle').style.transform = 'rotate(' + data.pos + 'deg)';
            }
        }

        function enviarComando(cmd) {
            let message = new Paho.MQTT.Message(cmd);
            message.destinationName = "rotor/control";
            client.send(message);
        }

        function enviarTarget() {
            let val = document.getElementById('targetInput').value;
            if(val !== "") {
                enviarComando("GOTO:" + val);
            }
        }
    </script>
</body>
</html>
